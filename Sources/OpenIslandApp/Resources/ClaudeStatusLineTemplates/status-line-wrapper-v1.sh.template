#!/bin/bash
# Claude Code StatusLine Script (wrapper mode)
# Auto-configured by Open Island.
# Open Island status-line template version: 1
cache_path={{OPEN_ISLAND_CACHE_PATH_SHELL_QUOTED}}
delegate_path={{OPEN_ISLAND_DELEGATE_PATH_SHELL_QUOTED}}
input=$(cat)
_rl=$(printf '%s' "$input" | jq -c '.rate_limits // empty' 2>/dev/null)
[ -n "$_rl" ] && { umask 077; mkdir -p "$(dirname "$cache_path")"; chmod 700 "$(dirname "$cache_path")"; printf '%s\n' "$_rl" > "$cache_path"; chmod 600 "$cache_path"; }
printf '%s' "$input" | "$delegate_path"
