/* Poured §F hint (F2). The board's `.q-hint` reads "Press [1–3] to pick" with the
   range on a real `kbd` chip (`01-poured-island.html:1195-1196`) — it does NOT
   carry the shipped "Enter submits · Esc closes" tail, which is why Poured takes
   its own key instead of `question.hint.keyboard.range`. `%@` is the chip. */
"poured.question.hint.pick" = "Press %@ to pick";
