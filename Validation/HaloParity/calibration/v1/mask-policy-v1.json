{
  "schemaVersion": "1.0.0",
  "policyId": "halo-mask-policy-v1",
  "status": "frozen-definition-no-mask-images-yet",
  "requiredMaskFamilies": [
    "silhouette-body",
    "edge-core",
    "emissive-bloom",
    "non-text-content",
    "text-layout-boxes",
    "os-external"
  ],
  "allowedMaskedPixels": [
    "window chrome outside Halo crop",
    "browser chrome outside Halo crop",
    "capture padding",
    "out-of-crop timing fiducial"
  ],
  "forbiddenMaskedPixels": [
    "Halo-owned black surface",
    "living edge core",
    "emissive bloom",
    "Halo text",
    "seams or duplicate silhouettes",
    "known or candidate divergence"
  ],
  "freezeRule": "Dimensions, purpose, author, source hashes, and PNG SHA-256 are required before Gate 0B can pass.",
  "changeRule": "Any mask change reopens Gate 0B and every later gate."
}
