  "captureMatrix": [
    {"renderer": "in-app-browser", "profileId": "notch-v1", "staticRepetitions": 10, "motionRepetitions": 3},
    {"renderer": "in-app-browser", "profileId": "top-bar-v1", "staticRepetitions": 10, "motionRepetitions": 3},
    {"renderer": "open-island-app", "profileId": "notch-v1", "staticRepetitions": 10, "motionRepetitions": 3},
    {"renderer": "open-island-app", "profileId": "top-bar-v1", "staticRepetitions": 10, "motionRepetitions": 3}
  ],
  "forbiddenInputs": [
