    {"id": "font-raster-boxes", "kind": "neutral-text-layout", "families": ["system-sans", "system-mono"], "sizes": [10, 11, 12, 13]},
    {"id": "motion-track", "kind": "neutral-linear-motion", "durationMs": 1000, "distanceMappedUnits": 120}
