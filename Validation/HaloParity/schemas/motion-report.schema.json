{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "halo-parity/motion-report.schema.json",
  "type": "object",
  "required": ["scenarioId", "profileId", "eventId", "clockMode", "repetitions", "frameZero", "timestamps", "droppedFrames", "duplicateFrames", "continuity", "settle", "result"],
  "properties": {
    "clockMode": {"enum": ["diagnostic-seek", "normal-attestation"]},
    "result": {"enum": ["passed", "not-passed"]}
  }
}
