{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "halo-parity/authenticity.schema.json",
  "type": "object",
  "required": [
    "renderer",
    "captureMode",
    "captureAPI",
    "result",
    "canonicalEligible",
    "canonicalIneligibilityReasons",
    "artifactPath",
    "artifactSha256",
    "profileId",
    "scenarioId",
    "onScreen",
    "window",
    "captureHelper"
  ],
  "properties": {
    "renderer": {
      "enum": [
        "in-app-browser",
        "open-island-app",
        "native-swiftui-calibration"
      ]
    },
    "captureMode": {"const": "live-window"},
    "captureAPI": {"const": "ScreenCaptureKit"},
    "result": {"const": "captured"},
    "canonicalEligible": {"type": "boolean"},
    "canonicalIneligibilityReasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "artifactPath": {"type": "string", "minLength": 1},
    "artifactSha256": {"$ref": "#/$defs/sha256"},
    "profileId": {"enum": ["notch-v1", "top-bar-v1"]},
    "scenarioId": {"type": "string", "minLength": 1},
    "onScreen": {"const": true},
    "proxyRenderer": {"enum": [false, null]},
    "nativeSidecar": {"$ref": "#/$defs/nativeSidecar"},
    "nativeExpectations": {
      "type": "object",
      "required": [
        "scenarioId",
        "profileId",
        "resolvedThemeID",
        "motion",
        "accessibility",
        "event"
      ],
      "properties": {
        "scenarioId": {"type": "string", "minLength": 1},
        "profileId": {"enum": ["notch-v1", "top-bar-v1"]},
        "resolvedThemeID": {"const": "halo"},
        "motion": {"enum": ["normal", "reduced"]},
        "accessibility": {"$ref": "#/$defs/accessibility"},
        "event": {"type": ["string", "null"]}
      }
    },
    "captureTiming": {"type": ["object", "null"]},
    "calibrationRenderer": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"renderer": {"const": "open-island-app"}},
        "required": ["renderer"]
      },
      "then": {"required": ["nativeSidecar", "nativeExpectations"]}
    },
    {
      "if": {
        "properties": {"renderer": {"const": "native-swiftui-calibration"}},
        "required": ["renderer"]
      },
      "then": {"required": ["captureTiming", "calibrationRenderer"]}
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "accessibility": {
      "enum": [
        "standard",
        "reduce-motion",
        "increase-contrast",
        "reduce-transparency",
        "keyboard",
        "voiceover",
        "text-scale"
      ]
    },
    "nativeSidecar": {
      "type": "object",
      "required": [
        "schemaVersion",
        "scenario",
        "manifestDisposition",
        "lockedNativeFixtureIdentifier",
        "profile",
        "motion",
        "accessibility",
        "event",
        "seed",
        "fixtureSchemaVersion",
        "fixtureHash",
        "fixtureVariant",
        "resolvedThemeID",
        "clock",
        "executable",
        "process",
        "fixture",
        "placement",
        "generatedAt",
        "isolation"
      ],
      "properties": {
        "schemaVersion": {"const": "halo-native-capture-sidecar-v1"},
        "scenario": {"type": "string", "minLength": 1},
        "manifestDisposition": {"const": "exact"},
        "lockedNativeFixtureIdentifier": {"type": "string", "minLength": 1},
        "profile": {"enum": ["notch-v1", "top-bar-v1"]},
        "motion": {"enum": ["normal", "reduced"]},
        "accessibility": {"$ref": "#/$defs/accessibility"},
        "event": {"type": ["string", "null"]},
        "seed": {"type": "integer", "minimum": 0},
        "fixtureSchemaVersion": {"type": "string", "minLength": 1},
        "fixtureHash": {"$ref": "#/$defs/sha256"},
        "fixtureVariant": {"type": "string", "minLength": 1},
        "resolvedThemeID": {"const": "halo"},
        "clock": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["production-monotonic", "reduced-motion"]}
          }
        },
        "executable": {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "buildId",
            "configuration",
            "gitRevision",
            "sourceTreeDirty"
          ],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "buildId": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{8}(-[A-Fa-f0-9]{4}){3}-[A-Fa-f0-9]{12}$"
            },
            "configuration": {"type": "string", "minLength": 1},
            "gitRevision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "sourceTreeDirty": {"type": "boolean"}
          }
        },
        "process": {
          "type": "object",
          "required": ["pid", "startTime", "bundleId"],
          "properties": {
            "pid": {"type": "integer", "minimum": 1},
            "startTime": {"type": "string", "format": "date-time"},
            "bundleId": {"type": "string", "minLength": 1},
            "executablePath": {"type": "string", "minLength": 1},
            "executableSha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "fixture": {
          "type": "object",
          "required": ["id", "payloadSha256", "liveDataAbsent"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "payloadSha256": {"$ref": "#/$defs/sha256"},
            "liveDataAbsent": {"const": true}
          }
        },
        "placement": {
          "type": "object",
          "required": [
            "requestedProfileId",
            "resolvedMode",
            "targetScreenId",
            "targetScreenName",
            "selectionSummary",
            "screenFrame",
            "visibleFrame",
            "safeAreaInsets",
            "cgWindowId",
            "windowLayer",
            "actualWindowGeometry"
          ],
          "properties": {
            "requestedProfileId": {"enum": ["notch-v1", "top-bar-v1"]},
            "resolvedMode": {"enum": ["notch", "topBar"]},
            "targetScreenId": {"type": "string", "minLength": 1},
            "targetScreenName": {"type": "string", "minLength": 1},
            "selectionSummary": {"type": "string", "minLength": 1},
            "screenFrame": {"$ref": "#/$defs/rect"},
            "visibleFrame": {"$ref": "#/$defs/rect"},
            "cgWindowId": {"type": "integer", "minimum": 1},
            "windowLayer": {"type": "integer"},
            "actualWindowGeometry": {"$ref": "#/$defs/rect"},
            "safeAreaInsets": {
              "type": "object",
              "required": ["top", "left", "bottom", "right"],
              "properties": {
                "top": {"type": "number"},
                "left": {"type": "number"},
                "bottom": {"type": "number"},
                "right": {"type": "number"}
              }
            }
          }
        },
        "generatedAt": {"type": "string", "format": "date-time"},
        "isolation": {
          "type": "object",
          "required": [
            "runtimeStateLoadingDisabled",
            "bridgeStartupDisabled",
            "allSessionsAreDemoOrigin",
            "fixtureSessionIDs"
          ],
          "properties": {
            "runtimeStateLoadingDisabled": {"const": true},
            "bridgeStartupDisabled": {"const": true},
            "allSessionsAreDemoOrigin": {"const": true},
            "fixtureSessionIDs": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "acknowledgedEvents": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "state": {
          "type": "object",
          "required": [
            "scenario",
            "profile",
            "motion",
            "accessibility",
            "acknowledgedEvents"
          ]
        }
      }
    }
  }
}
