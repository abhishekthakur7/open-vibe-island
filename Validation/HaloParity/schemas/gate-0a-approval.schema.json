{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "halo-parity/gate-0a-approval.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "namespace",
    "gate",
    "scope",
    "principal",
    "decision",
    "createdAt",
    "bindings",
    "noWaivers",
    "statements"
  ],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "namespace": {"const": "halo-parity"},
    "gate": {"const": "0A"},
    "scope": {"const": "reference-authoring-and-display-profile-authority"},
    "principal": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
    "decision": {"const": "approve"},
    "createdAt": {"type": "string", "minLength": 1},
    "noWaivers": {"const": true},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "digestAlgorithm",
        "authorityProjection",
        "authorityProjectionSha256"
      ],
      "properties": {
        "canonicalization": {"const": "RFC8785-integer-BMP-subset"},
        "digestAlgorithm": {"const": "sha256"},
        "authorityProjection": {
          "$ref": "gate-0a-authority-projection.schema.json"
        },
        "authorityProjectionSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "statements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoringProfileAuthorityOnly",
        "noScenarioPass",
        "notGate7Approval",
        "noGoldens"
      ],
      "properties": {
        "authoringProfileAuthorityOnly": {"const": true},
        "noScenarioPass": {"const": true},
        "notGate7Approval": {"const": true},
        "noGoldens": {"const": true}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
