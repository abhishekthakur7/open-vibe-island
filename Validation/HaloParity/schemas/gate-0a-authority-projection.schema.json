{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "halo-parity/gate-0a-authority-projection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectionType",
    "referenceAuthority",
    "displayProfiles",
    "scenarioIds"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "projectionType": {
      "const": "halo-gate-0a-reference-and-display-authority"
    },
    "referenceAuthority": {
      "$ref": "reference-authority.schema.json"
    },
    "displayProfiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/profile"}
    },
    "scenarioIds": {
      "type": "array",
      "minItems": 57,
      "maxItems": 57,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "positiveInteger": {"type": "integer", "minimum": 1},
    "sizePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "heightPolicy"],
      "properties": {
        "width": {"$ref": "#/$defs/positiveInteger"},
        "heightPolicy": {"type": "string", "minLength": 1}
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {"type": "string", "minLength": 1},
        "exclude": {"type": "string", "minLength": 1}
      }
    },
    "captureIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "displayID",
        "localizedName",
        "connectionType",
        "framePoints",
        "nativePixels",
        "backingScale",
        "maximumFramesPerSecond",
        "iccBytes",
        "iccSha256",
        "productID",
        "vendorID",
        "serialNumber"
      ],
      "properties": {
        "status": {"const": "resolved"},
        "displayID": {"$ref": "#/$defs/positiveInteger"},
        "localizedName": {"type": "string", "minLength": 1},
        "connectionType": {"enum": ["internal", "external"]},
        "framePoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"$ref": "#/$defs/positiveInteger"},
            "height": {"$ref": "#/$defs/positiveInteger"}
          }
        },
        "nativePixels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"$ref": "#/$defs/positiveInteger"},
            "height": {"$ref": "#/$defs/positiveInteger"}
          }
        },
        "backingScale": {"const": 2},
        "maximumFramesPerSecond": {"$ref": "#/$defs/positiveInteger"},
        "iccBytes": {"$ref": "#/$defs/positiveInteger"},
        "iccSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "productID": {"type": "string", "minLength": 1},
        "vendorID": {"type": "string", "minLength": 1},
        "serialNumber": {"type": "string", "minLength": 1}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayClass",
        "pointSize",
        "pixelSize",
        "backingScale",
        "colorSpace",
        "refreshTargetHz",
        "panel",
        "crop",
        "captureDisplayIdentity"
      ],
      "properties": {
        "id": {"enum": ["notch-v1", "top-bar-v1"]},
        "displayClass": {"enum": ["built-in-notch", "external-top-bar"]},
        "pointSize": {"$ref": "#/$defs/sizePolicy"},
        "pixelSize": {"$ref": "#/$defs/sizePolicy"},
        "backingScale": {"const": 2},
        "colorSpace": {"type": "string", "minLength": 1},
        "refreshTargetHz": {"const": 60},
        "panel": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": {
            "type": ["string", "integer"]
          }
        },
        "crop": {"$ref": "#/$defs/crop"},
        "captureDisplayIdentity": {"$ref": "#/$defs/captureIdentity"}
      }
    }
  }
}
