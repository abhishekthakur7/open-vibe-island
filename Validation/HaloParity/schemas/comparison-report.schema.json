{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "halo-parity/comparison-report.schema.json",
  "type": "object",
  "required": ["scenarioId", "profileId", "sourceHashes", "captureHashes", "maskHashes", "thresholdProfileHash", "registration", "hardInvariants", "dimensions", "result"],
  "properties": {
    "dimensions": {
      "type": "object",
      "required": ["structural", "visual", "copyData", "interaction", "motion"]
    },
    "result": {"enum": ["passed", "not-passed"]}
  }
}
