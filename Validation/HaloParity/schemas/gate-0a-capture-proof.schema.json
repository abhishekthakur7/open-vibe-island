{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "halo-parity/gate-0a-capture-proof.schema.json",
  "type": "object",
  "required": ["schemaVersion", "passed", "rendererProofs"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "passed": {"const": true},
    "rendererProofs": {
      "type": "object",
      "required": ["in-app-browser", "open-island-app"],
      "additionalProperties": false,
      "properties": {
        "in-app-browser": {"$ref": "#/$defs/rendererProof"},
        "open-island-app": {"$ref": "#/$defs/rendererProof"}
      }
    }
  },
  "$defs": {
    "rendererProof": {
      "type": "object",
      "required": [
        "canonicalEligible",
        "captureMode",
        "captureAPI",
        "authenticityComplete",
        "authenticitySidecar",
        "authenticitySha256"
      ],
      "properties": {
        "canonicalEligible": {"const": true},
        "captureMode": {"const": "live-window"},
        "captureAPI": {"const": "ScreenCaptureKit"},
        "authenticityComplete": {"const": true},
        "authenticitySidecar": {"type": "string", "minLength": 1},
        "authenticitySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
