{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "halo-parity/reference-authority.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityId",
    "status",
    "source",
    "referenceSeed",
    "designLaws",
    "defaultMode",
    "controllerSchema",
    "events",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "authorityId": {"const": "halo-reference-authority-v1"},
    "status": {"const": "pending-authorized-human-approval"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "docs/design/overlay-redesign/06-halo.html"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "referenceSeed": {"type": "string", "minLength": 1},
    "designLaws": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "defaultMode": {"const": "inert-original-board"},
    "controllerSchema": {"$ref": "#/$defs/controllerSchema"},
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointer-enter",
        "pointer-exit",
        "open",
        "close",
        "expand-row",
        "collapse-row",
        "approve",
        "deny",
        "next",
        "select-option",
        "toggle-option",
        "type-other",
        "submit",
        "complete-success",
        "complete-interrupted",
        "complete-failed",
        "insert-row",
        "focus-next",
        "escape",
        "scroll",
        "none"
      ],
      "properties": {
        "pointer-enter": {"$ref": "#/$defs/eventTransition"},
        "pointer-exit": {"$ref": "#/$defs/eventTransition"},
        "open": {"$ref": "#/$defs/eventTransition"},
        "close": {"$ref": "#/$defs/eventTransition"},
        "expand-row": {"$ref": "#/$defs/eventTransition"},
        "collapse-row": {"$ref": "#/$defs/eventTransition"},
        "approve": {"$ref": "#/$defs/eventTransition"},
        "deny": {"$ref": "#/$defs/eventTransition"},
        "next": {"$ref": "#/$defs/eventTransition"},
        "select-option": {"$ref": "#/$defs/eventTransition"},
        "toggle-option": {"$ref": "#/$defs/eventTransition"},
        "type-other": {"$ref": "#/$defs/eventTransition"},
        "submit": {"$ref": "#/$defs/eventTransition"},
        "complete-success": {"$ref": "#/$defs/eventTransition"},
        "complete-interrupted": {"$ref": "#/$defs/eventTransition"},
        "complete-failed": {"$ref": "#/$defs/eventTransition"},
        "insert-row": {"$ref": "#/$defs/eventTransition"},
        "focus-next": {"$ref": "#/$defs/eventTransition"},
        "escape": {"$ref": "#/$defs/eventTransition"},
        "scroll": {"$ref": "#/$defs/eventTransition"},
        "none": {"$ref": "#/$defs/eventTransition"}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 57,
      "maxItems": 57,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonEmptyStringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "eventTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to"],
      "properties": {
        "to": {"type": "string", "minLength": 1}
      }
    },
    "controllerSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "scenarioIds",
        "profiles",
        "motionModes",
        "accessibilityModes",
        "eventIds",
        "seedPattern",
        "timeMs"
      ],
      "properties": {
        "required": {
          "const": [
            "scenarioId",
            "profile",
            "motionMode",
            "accessibilityMode",
            "seed",
            "eventId",
            "timeMs"
          ]
        },
        "scenarioIds": {
          "type": "array",
          "minItems": 57,
          "maxItems": 57,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "profiles": {"const": ["notch-v1", "top-bar-v1"]},
        "motionModes": {"const": ["manual", "normal", "reduced"]},
        "accessibilityModes": {
          "const": [
            "default",
            "reduce-motion",
            "increase-contrast",
            "reduce-transparency",
            "keyboard",
            "voiceover",
            "text-scale"
          ]
        },
        "eventIds": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "seedPattern": {"const": "^[A-Za-z0-9._:-]{1,128}$"},
        "timeMs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"const": 0},
            "maximum": {"const": 3600000}
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "referenceSection",
        "intent",
        "mapping",
        "expected",
        "checkpoints",
        "referenceEvents"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "referenceSection": {"type": "string", "minLength": 1},
        "intent": {"type": "string", "minLength": 1},
        "mapping": {
          "oneOf": [
            {"$ref": "#/$defs/establishedMapping"},
            {"$ref": "#/$defs/authoredMapping"}
          ]
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visibleCopy",
            "grouping",
            "order",
            "stateMembership",
            "lightBehavior"
          ],
          "properties": {
            "visibleCopy": {"$ref": "#/$defs/nonEmptyStringArray"},
            "grouping": {"$ref": "#/$defs/nonEmptyStringArray"},
            "order": {"$ref": "#/$defs/nonEmptyStringArray"},
            "stateMembership": {"$ref": "#/$defs/nonEmptyStringArray"},
            "lightBehavior": {"type": "string", "minLength": 1}
          }
        },
        "checkpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stable", "timed"],
          "properties": {
            "stable": {"$ref": "#/$defs/nonEmptyStringArray"},
            "timed": {"$ref": "#/$defs/nonEmptyStringArray"}
          }
        },
        "referenceEvents": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "establishedMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selector", "stateMechanism"],
      "properties": {
        "kind": {"const": "established-anchor"},
        "selector": {"type": "string", "minLength": 1},
        "stateMechanism": {"type": "string", "minLength": 1}
      }
    },
    "authoredMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "variantId",
        "selector",
        "sourceAnchor",
        "laws",
        "decision"
      ],
      "properties": {
        "kind": {"const": "authored-variant"},
        "variantId": {"type": "string", "minLength": 1},
        "selector": {"type": "string", "minLength": 1},
        "sourceAnchor": {"type": "string", "minLength": 1},
        "laws": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cloneSelector", "laws", "eventSeam", "patches"],
          "properties": {
            "cloneSelector": {"type": "string", "minLength": 1},
            "laws": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "eventSeam": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "frameZeroEvent",
                "clockModes",
                "stableCheckpoints",
                "timedCheckpoints",
                "deterministicPhaseKey"
              ],
              "properties": {
                "frameZeroEvent": {"type": "string", "minLength": 1},
                "clockModes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"enum": ["manual", "normal"]}
                },
                "stableCheckpoints": {"$ref": "#/$defs/nonEmptyStringArray"},
                "timedCheckpoints": {"$ref": "#/$defs/nonEmptyStringArray"},
                "deterministicPhaseKey": {"type": "string", "minLength": 1}
              }
            },
            "patches": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "selector", "value"],
                "properties": {
                  "op": {
                    "enum": [
                      "appendBadge",
                      "replaceText",
                      "setAttribute",
                      "setStateClass"
                    ]
                  },
                  "selector": {"type": "string", "minLength": 1},
                  "name": {"type": "string", "minLength": 1},
                  "value": {"type": "string"}
                }
              }
            }
          }
        }
      }
    }
  }
}
