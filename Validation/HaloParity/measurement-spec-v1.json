{
  "schemaVersion": "1.0.0",
  "specId": "halo-measurement-v1",
  "status": "frozen-before-calibration",
  "authority": {
    "basis": "Halo visual-parity audit hard laws and pre-candidate reference geometry",
    "frozenBeforeNativeStyling": true,
    "haloCandidatePixelsUsed": false
  },
  "coordinateSpaces": {
    "logical": "mapped unit: CSS px for reference and SwiftUI pt for native",
    "physical": "device pixel",
    "provisionalTransform": {
      "cssPxToSwiftUIPt": 1.0,
      "swiftUIPtToDevicePx": 2.0,
      "status": "must-be-proven-by-neutral-calibration"
    },
    "canonicalScale": 2
  },
  "profiles": ["notch-v1", "top-bar-v1"],
  "roiPolicy": {
    "source": "reference-spec-v1 per-row declared regions",
    "freezePoint": "before calibration capture",
    "allowedExclusions": ["window-chrome", "browser-chrome", "capture-padding", "timing-fiducial"],
    "forbiddenExclusions": ["halo-surface", "halo-edge", "halo-bloom", "halo-text", "halo-interaction", "known-divergence"]
  },
  "registration": {
    "algorithm": "translation-only phase-correlation over declared neutral fiducials",
    "scalingAllowed": false,
    "rotationAllowed": false,
    "nonlinearWarpAllowed": false,
    "contentAwareAlignmentAllowed": false,
    "residualPhysicalPxMax": 0.5
  },
  "sampling": {
    "staticColdRepetitionsPerRendererProfile": 10,
    "motionRepetitionsPerRendererProfileEvent": 3,
    "motionEveryRepetitionMustPass": true,
    "targetFramesPerSecond": 60,
    "checkpointFractions": [0.0, 0.1, 0.25, 0.5, 0.75, 1.0],
    "eventFrameZero": "first decoded frame containing the acknowledged out-of-crop fiducial transition",
    "eventMarkerLatencyFramesMax": 2
  },
  "staticMetrics": {
    "surfaceBlack": {
      "algorithm": "decoded unpremultiplied sRGB sample over declared interior ROI",
      "requiredRGB": [0, 0, 0],
      "aggregation": "all sampled owned interior pixels"
    },
    "componentCount": {
      "algorithm": "8-connected components over thresholded owned-surface alpha",
      "expected": 1
    },
    "silhouette": {
      "algorithm": "binary owned-surface alpha after translation-only registration",
      "iouMin": 0.99,
      "hausdorffPhysicalPxMax": 1.0,
      "holesExpected": 0,
      "attachmentRequired": true
    },
    "edgeCore": {
      "centerlineAlgorithm": "ridge maximum normal to declared expected perimeter",
      "nominalMappedUnits": 1.5,
      "widthPhysicalPxNominal": 3.0,
      "widthPhysicalPxTolerance": 1.0,
      "scoreSeparatelyFromBloom": true
    },
    "idle": {
      "edgeAlpha": 0.08,
      "bloomEnergyOutsideEdgeMax": 0.0,
      "motionAllowed": false
    },
    "workingSegment": {
      "dominantComponent": "moving-edge-segment",
      "fullPerimeterDominanceAllowed": false,
      "arcFractionMin": 0.08,
      "arcFractionMax": 0.35,
      "bloomToCoreEnergyRatioMax": 0.75
    },
    "salience": {
      "classifier": "connected components above neutral-calibrated luminance-plus-local-contrast floor",
      "thresholdSource": "neutral-calibration-only",
      "dominantComponentCountExpected": 1,
      "aggregation": "per required stable checkpoint"
    },
    "bloom": {
      "algorithm": "luminance energy outside edge-core ROI in concentric one-pixel bands",
      "falloff": "non-increasing median luminance away from the localized source",
      "edgeCompensationForbidden": true
    },
    "attentionHandoff": {
      "algorithm": "track luminance-energy centroids for perimeter and actionable target ROIs",
      "perimeterEnvelope": "non-increasing after event frame zero",
      "targetEnvelope": "non-decreasing through declared handoff peak",
      "oneDominantLocus": true
    }
  },
  "motionMetrics": {
    "clockModes": {
      "normalAttestation": "production monotonic clock only",
      "diagnosticSeek": "manual injected time; never substitutes for normal"
    },
    "frameIdentity": {
      "hash": "SHA-256 of decoded BGRA pixels",
      "duplicateDetection": "equal adjacent decoded hashes outside declared still windows",
      "droppedDetection": "PTS delta greater than 1.5 target refresh intervals"
    },
    "silhouetteContinuity": {
      "detachedComponentFails": true,
      "duplicateSurfaceFails": true,
      "crossfadeFails": true,
      "flashFails": true,
      "seamFails": true,
      "algorithm": "per-frame connected components plus adjacent-frame alpha topology and luminance jump"
    },
    "settleWindows": {
      "morph": {"start": "reference-spec duration end", "durationMs": 500, "permittedMovement": "declared light whitelist only"},
      "success": {"startMs": 3000, "durationMs": 500, "permittedMovement": "none except idle hairline noise floor"},
      "rowEntrance": {"start": "reference-spec entrance end", "durationMs": 500, "permittedMovement": "declared ambient light only"}
    },
    "permittedLightWhitelistSource": "reference-spec-v1 per-row immutable ROI IDs",
    "unexpectedDroppedFramesMax": 0,
    "unexpectedDuplicateFramesMax": 0,
    "motionBoundaryRefreshFramesMax": 1
  },
  "semanticChecks": {
    "visibleCopy": "exact Unicode scalar equality against scenario expected.visibleCopy",
    "groupOrder": ["Needs You", "Running", "Done"],
    "membership": "exact fixture session IDs per group",
    "forbiddenVisibleTokens": ["Exec", "Wait", "Thinking"],
    "forbiddenFallbackExact": "/",
    "colorOnlyStateAllowed": false,
    "textRasterizationScoredSeparately": true
  },
  "interactionChecks": {
    "eventTraceSource": "scenario manifest trigger sequence plus reference-spec event IDs",
    "requiredClasses": ["hover-dwell", "peek", "open-close", "row-expansion", "dismissal", "jump", "transcript", "reply", "permission", "question-pagination", "question-selection", "question-freeform", "question-submit", "focus", "keyboard", "scroll", "overflow"],
    "missingEventFails": true,
    "incorrectActionFails": true
  },
  "accessibilityChecks": {
    "variants": ["reduce-motion", "increase-contrast", "reduce-transparency", "keyboard-only", "voiceover", "text-scaling"],
    "exactRoleNameStateOrder": true,
    "stateMeaningPreserved": true,
    "normalAndReducedMotionIndependent": true
  },
  "hardCaps": {
    "interiorBlackRGB": [0, 0, 0],
    "registrationPhysicalPxMax": 0.5,
    "silhouetteIoUMin": 0.99,
    "silhouetteHausdorffPhysicalPxMax": 1.0,
    "matchedNeutralMedianDeltaE00Max": 1.0,
    "matchedNeutralP95DeltaE00Max": 2.0,
    "unexpectedDroppedFramesMax": 0,
    "unexpectedDuplicateFramesMax": 0,
    "motionBoundaryRefreshFramesMax": 1
  },
  "forbiddenInputs": ["halo-reference-divergence", "halo-candidate-divergence", "known-halo-defect", "post-styling-selected-sample", "candidate-failing-metric"],
  "changePolicy": {
    "algorithmOrROIChangeReopens": "0A",
    "thresholdOrMaskChangeReopens": "0B and every later gate",
    "postResultSelectionAllowed": false
  }
}
